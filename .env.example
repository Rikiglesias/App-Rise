# Environment Configuration Template
# Copy this file to .env.development and fill with your actual values

NODE_ENV=development
APP_VERSION=1.0.0
EXPO_PUBLIC_API_BASE_URL=https://api.riseagainsthunger.italia.dev
ENABLE_FLIPPER=true
ENABLE_PERFORMANCE_MONITORING=true
LOG_LEVEL=debug

# EAS Configuration - Replace with your actual project ID
EAS_PROJECT_ID=your-eas-project-id-here

# Apple Developer Configuration (for EAS Submit)
APPLE_ID=your-apple-id-email@example.com
ASC_APP_ID=your-app-store-connect-app-id
APPLE_TEAM_ID=your-apple-team-id

# App Configuration (for app.config.js)
IOS_BUNDLE_IDENTIFIER=it.creareunapp.editor.ios63da226b4447c
IOS_BUILD_NUMBER=19
ANDROID_PACKAGE=org.riseagainsthunger.italia
ANDROID_VERSION_CODE=4

# Expo Updates Code Signing (set paths or contents in CI)
EXPO_UPDATES_CODE_SIGNING_CERTIFICATE=./certs/updates.pem
EXPO_UPDATES_CODE_SIGNING_KEY_ID=main
EXPO_UPDATES_CODE_SIGNING_ALGORITHM=rsa-v1_5-sha256

# Add other environment-specific variables here
# EXPO_PUBLIC_API_KEY=your-api-key-here
# DATABASE_URL=your-database-url-here

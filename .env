# Configurazione per EAS Submit automatico
# ATTENZIONE: Non committare mai questo file!

# Apple Developer Configuration
APPLE_ID=salbieri@riseagainsthunger.it
ASC_APP_ID=6447248221
APPLE_TEAM_ID=7U2FBGZ8S6

# Android Configuration (opzionale)
# Decommentare quando disponibile il service account JSON
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# Environment
NODE_ENV=production
ENABLE_FLIPPER=false
ENABLE_PERFORMANCE_MONITORING=true
LOG_LEVEL=info
EXPO_PUBLIC_API_BASE_URL=https://api.riseagainsthunger.org

EXPO_UPDATES_CODE_SIGNING_CERTIFICATE=./certs/updates.pem
EXPO_UPDATES_CODE_SIGNING_KEY_ID=main
EXPO_UPDATES_CODE_SIGNING_ALGORITHM=rsa-v1_5-sha256

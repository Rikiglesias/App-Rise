## 📏 **DIMENSIONI STANDARD**

```typescript
const TextSizes = {
  hero: 75,     // Titoli hero "Rise Against Hunger Italia"
  title: 40,    // Titoli principali "Fai la Differenza"  
  subtitle: 35, // Sottotitoli "Entra in Azione"
  body: 20,     // Testo body importante
  normal: 16,   // Testo normale
  caption: 14,  // Didascalie
  small: 12     // Testo piccolo
};

const ResponsivePresets = {
  card: "100% → 47.5% → 31% → 20%",      // Card width automatica
  modal: "95% → 90% → 70% → 50%",        // Modal width automatica
  container: "95% → 90% → 85% → 70%",    // Container width automatica
};

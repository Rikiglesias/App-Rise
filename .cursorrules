## 💡 **TEMPLATE COMPONENTI PERFETTI**

### **COMPONENTE PERFETTO COMPLETO**
```typescript
import { 
  PerfectText, PerfectImage, PerfectContainer,
  PageContainer, useUniversalTheme 
} from '@/components/ui';

const PerfectComponent = ({ title, description, image, items }) => {
  const { toggleTheme } = useUniversalTheme();
  
  return (
    <PageContainer theme="auto">
      {/* Hero image sempre perfetta */}
      <PerfectImage preset="hero" source={image} rounded={12} shadow="medium" />
      
      {/* Titolo mai tagliato */}
      <PerfectText size={48} lines={2} immunity={true} weight="bold">
            {title}
      </PerfectText>
      
      {/* Descrizione sempre esatta */}
      <PerfectText size={16} lines={4} immunity={true}>
          {description}
      </PerfectText>
        
      {/* Grid automatico */}
      <PerfectContainer preset="section">
          {items.map(item => (
          <CardContainer key={item.id} elevated theme="auto">
            <PerfectImage preset="card" source={item.image} />
            <PerfectText size={20} lines={1} weight="bold">
              {item.name}
            </PerfectText>
            <PerfectText size={14} lines={3}>
              {item.description}
            </PerfectText>
          </CardContainer>
        ))}
      </PerfectContainer>
      
      {/* Dark mode universale */}
      <TouchableOpacity onPress={toggleTheme}>
        <PerfectText size={16}>🌙 Toggle Dark Mode</PerfectText>
      </TouchableOpacity>
    </PageContainer>
  );
};

export default PerfectComponent;
```

### **SCREEN PERFETTO COMPLETO**
```typescript
import { 
  PerfectText, PerfectImage, PerfectContainer,
  PageContainer, CardContainer, useUniversalTheme 
} from '@/components/ui';

const PerfectScreen = ({ data }) => {
  const { theme, colors } = useUniversalTheme();
  
  return (
    <PageContainer theme="auto">
      {/* Header section */}
      <PerfectContainer preset="section">
        <PerfectTitle size={48} lines={1}>
          {data.screenTitle}
        </PerfectTitle>
        
        <PerfectSubtitle size={24} lines={2}>
          {data.screenSubtitle}
        </PerfectSubtitle>
      </PerfectContainer>
      
      {/* Hero section */}
      <PerfectContainer preset="section">
        <HeroImage source={data.heroImage} />
        
        <PerfectBody size={16} lines={4}>
          {data.heroDescription}
        </PerfectBody>
      </PerfectContainer>
      
      {/* Content grid */}
      <PerfectContainer preset="section">
        {data.contentItems.map(item => (
          <CardContainer key={item.id} elevated>
            <CardImage source={item.image} />
            
            <PerfectContainer preset="section">
              <PerfectText size={18} lines={1} weight="bold">
                {item.title}
              </PerfectText>
              
              <PerfectText size={14} lines={3}>
              {item.description}
              </PerfectText>
            </PerfectContainer>
          </CardContainer>
        ))}
      </PerfectContainer>
      
      {/* Footer actions */}
      <PerfectContainer preset="section">
        <TouchableOpacity>
          <CardContainer elevated theme="auto">
            <PerfectText size={18} weight="bold" color="auto">
              Call to Action
            </PerfectText>
          </CardContainer>
      </TouchableOpacity>
      </PerfectContainer>
    </PageContainer>
  );
};

export default PerfectScreen;
```


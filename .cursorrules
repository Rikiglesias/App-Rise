## 🎯 **REGOLE CORE - ZERO TOLLERANZA**

### ✅ **LAYER CENTRALIZZATO OBBLIGATORIO**
```typescript
// ✅ CORRETTO - Sistema centralizzato
import { useResponsiveLayout } from '@/shared/hooks/useResponsiveLayout';
import { ResponsiveBox, ResponsiveStack, ResponsiveCard } from '@/components/ui';

const MyComponent = () => {
  const { responsive } = useResponsiveLayout();
  
  return (
    <ResponsiveBox preset="card" autoBackgroundColor="primary">
      <ResponsiveStack spacing={responsive({ compact: 16, xlarge: 24 })}>
        <FormattedText fontSize={24}>Testo + Layout responsivo</FormattedText>
      </ResponsiveStack>
    </ResponsiveBox>
  );
};

// ❌ VIETATO - Calcoli manuali frammentati
const { width: screenWidth } = Dimensions.get('window');
const isTablet = screenWidth >= 768;
const cardWidth = isTablet ? '31%' : '47.5%';
```

### ✅ **FORMATTEDTEXT OBBLIGATORIO**
```typescript
// ✅ CORRETTO
<FormattedText fontSize={24}>Testo responsivo</FormattedText>

// ❌ VIETATO
<Text style={{ fontSize: scaleFont(24) }}>Testo</Text>
```

### ✅ **APPROCCIO MISTO: Text Nativo + FormattedText**
```typescript
// ✅ CASO SPECIALE: Titoli critici che richiedono adjustsFontSizeToFit perfetto
import { Text } from 'react-native';
import { scaleFont } from '@/shared/constants/responsiveSystem';

<Text
  allowFontScaling={false}
  numberOfLines={1}
  adjustsFontSizeToFit={true}
  minimumFontScale={0.8}
  style={{ fontSize: scaleFont(42), fontWeight: '900' }}
>
  Rise Against Hunger Italia
</Text>

// ✅ CASO STANDARD: Sistema FormattedText bi-direzionale
<FormattedText 
  fontSize={32}
  intelligentAccessibilityScaling={true}
  fixed={true}
  fixedLines={1}
>
  Testo con sistema intelligente
</FormattedText>

// 🎯 DECISION RULE: 
// Titolo principale critico? → Text nativo
// Altri componenti? → FormattedText
```

### ✅ **SISTEMA BI-DIREZIONALE INTELLIGENTE OBBLIGATORIO**
```typescript
// ✅ CORRETTO - Sistema per APP IDENTICA su tutti i dispositivi
<FormattedText 
  fontSize={32}
  intelligentAccessibilityScaling={true}  // ← SISTEMA BI-DIREZIONALE ATTIVO
  fixed={true}
  fixedLines={1}                          // ← SEMPRE 1 riga esatta
  allowSystemFontScaling={false}          // ← CONSISTENCY ASSOLUTA
  lineBreakStrategyIOS="push-out"
  breakStrategyAndroid="highQuality"
>
  Rise Against Hunger Italia
</FormattedText>

// RISULTATI AUTOMATICI GARANTITI:
// iPhone SE (375px): 32px → 26px (ridotto automaticamente per 1 riga)
// iPhone 15 (414px): 32px → 32px (perfetto così)
// iPad (768px): 32px → 42px (ingrandito automaticamente per utilizzare spazio)
// iPad Pro (1024px): 32px → 48px (massima ottimizzazione automatica)
// RISULTATO: APP IDENTICA - stesse proporzioni visive ovunque

// ❌ VIETATO - Gestione manuale zoom/dispositivi
<FormattedText fontSize={screenWidth > 768 ? 32 : 24}>Testo</FormattedText>
{Platform.OS === 'ios' && <FormattedText fontSize={32}>iOS only</FormattedText>}

// ❌ VIETATO - Zoom che rompe layout controllato
<FormattedText 
  fixed={true}
  fixedLines={1}
  allowSystemFontScaling={true}  // ← ROMPE il sistema controllato
>
  Testo che può andare su più righe
</FormattedText>
```

### ✅ **CONFIGURAZIONE PERFETTA APP IDENTICA**
```typescript
// I 4 parametri FONDAMENTALI per app identica:
intelligentAccessibilityScaling={true}  // ← Adatta fontSize per ogni dispositivo
fixed={true}                            // ← Attiva sistema di calcolo intelligente  
fixedLines={1}                          // ← Numero righe esatto (mai nascoste)
allowSystemFontScaling={false}          // ← Evita zoom che rompe proportioni

// BENEFICIO: Un solo componente → perfetto su OGNI dispositivo automaticamente
```

### ✅ **PRESET DAL TEMA OBBLIGATORI**
```typescript
// ✅ CORRETTO - Preset unificati
<ResponsiveBox preset="card">         // 100% → 47.5% → 31% → 20% (Tablet XL!)
<ResponsiveBox preset="modal">        // 95% → 90% → 70% → 50%
<ResponsiveBox preset="container">    // 95% → 90% → 85% → 70%

// ❌ VIETATO - Percentuali hard-coded duplicate
<View style={{ width: '48%' }}>      // ImpactQuickStats frammentato
<View style={{ width: '60%' }}>      // SeguiciScreen frammentato
<View style={{ maxWidth: screenWidth * 0.9 }}>  // Modal duplicato
```

### ✅ **DARK MODE AUTOMATICO OBBLIGATORIO**
```typescript
// ✅ CORRETTO - Auto dark mode
<ResponsiveBox autoBackgroundColor="primary">   // Light: #FFFFFF, Dark: #0C0C0E
<ResponsiveCard autoBackgroundColor="card">     // Light: #FFFFFF, Dark: #2C2C2E

// Toggle centrale
const { toggleDarkMode } = useResponsiveDarkMode();

// ❌ VIETATO - Gestione manuale frammentata
<View style={{ backgroundColor: isDark ? '#1C1C1E' : '#FFFFFF' }}>
{isDark && <Text style={{ color: '#F5F5F5' }}>Dark text</Text>}
```

### ✅ **ZERO DOPPIO SCALING**
```typescript
// ✅ CORRETTO
<FormattedText fontSize={60}>Titolo</FormattedText>

// ❌ VIETATO
<FormattedText fontSize={scaleFont(24)}>Testo</FormattedText>
```

### ✅ **CROSS-PLATFORM CONSISTENCY OBBLIGATORIA**
```typescript
// ✅ CORRETTO - Risultato identico iOS/Android
<FormattedText 
  fontSize={24}
  lineBreakStrategyIOS="push-out"
  breakStrategyAndroid="highQuality"
  hyphenationFrequencyAndroid="full"
>
  Stesso risultato ovunque
</FormattedText>
```


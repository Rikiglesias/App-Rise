## 🎯 **REGOLE CORE - ZERO TOLLERANZA**

### ✅ **LAYER CENTRALIZZATO OBBLIGATORIO**
```typescript
// ✅ CORRETTO - Sistema centralizzato
import { useResponsiveLayout } from '@/shared/hooks/useResponsiveLayout';
import { ResponsiveBox, ResponsiveStack, ResponsiveCard } from '@/components/ui';

const MyComponent = () => {
  const { responsive } = useResponsiveLayout();
  
  return (
    <ResponsiveBox preset="card" autoBackgroundColor="primary">
      <ResponsiveStack spacing={responsive({ compact: 16, xlarge: 24 })}>
        <FormattedText fontSize={24}>Testo + Layout responsivo</FormattedText>
      </ResponsiveStack>
    </ResponsiveBox>
  );
};

// ❌ VIETATO - Calcoli manuali frammentati
const { width: screenWidth } = Dimensions.get('window');
const isTablet = screenWidth >= 768;
const cardWidth = isTablet ? '31%' : '47.5%';
```

### ✅ **FORMATTEDTEXT OBBLIGATORIO**
```typescript
// ✅ CORRETTO
<FormattedText fontSize={24}>Testo responsivo</FormattedText>

// ❌ VIETATO
<Text style={{ fontSize: scaleFont(24) }}>Testo</Text>
```

### ✅ **PRESET DAL TEMA OBBLIGATORI**
```typescript
// ✅ CORRETTO - Preset unificati
<ResponsiveBox preset="card">         // 100% → 47.5% → 31% → 20% (Tablet XL!)
<ResponsiveBox preset="modal">        // 95% → 90% → 70% → 50%
<ResponsiveBox preset="container">    // 95% → 90% → 85% → 70%

// ❌ VIETATO - Percentuali hard-coded duplicate
<View style={{ width: '48%' }}>      // ImpactQuickStats frammentato
<View style={{ width: '60%' }}>      // SeguiciScreen frammentato
<View style={{ maxWidth: screenWidth * 0.9 }}>  // Modal duplicato
```

### ✅ **DARK MODE AUTOMATICO OBBLIGATORIO**
```typescript
// ✅ CORRETTO - Auto dark mode
<ResponsiveBox autoBackgroundColor="primary">   // Light: #FFFFFF, Dark: #0C0C0E
<ResponsiveCard autoBackgroundColor="card">     // Light: #FFFFFF, Dark: #2C2C2E

// Toggle centrale
const { toggleDarkMode } = useResponsiveDarkMode();

// ❌ VIETATO - Gestione manuale frammentata
<View style={{ backgroundColor: isDark ? '#1C1C1E' : '#FFFFFF' }}>
{isDark && <Text style={{ color: '#F5F5F5' }}>Dark text</Text>}
```

### ✅ **ZERO DOPPIO SCALING**
```typescript
// ✅ CORRETTO
<FormattedText fontSize={60}>Titolo</FormattedText>

// ❌ VIETATO
<FormattedText fontSize={scaleFont(24)}>Testo</FormattedText>
```

### ✅ **CROSS-PLATFORM CONSISTENCY OBBLIGATORIA**
```typescript
// ✅ CORRETTO - Risultato identico iOS/Android
<FormattedText 
  fontSize={24}
  lineBreakStrategyIOS="push-out"
  breakStrategyAndroid="highQuality"
  hyphenationFrequencyAndroid="full"
>
  Stesso risultato ovunque
</FormattedText>
```


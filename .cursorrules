## 🚫 **ANTI-PATTERNS VIETATI ASSOLUTI**

### ❌ **SISTEMA PRECEDENTE COMPLETAMENTE VIETATO**
```typescript
// ❌ VIETATO - Componenti obsoleti
import { FormattedText, FormattedTextEnhanced } from '@/components/ui';
import { ResponsiveBox, ResponsiveStack, ResponsiveCard } from '@/components/ui';
import { ResponsiveImage } from '@/components/ui';
import { useResponsiveLayout, useResponsiveDarkMode } from '@/shared/hooks';

// ❌ VIETATO - Hook obsoleti
const { responsive, isTablet } = useResponsiveLayout();
const { isDark, toggleDarkMode } = useResponsiveDarkMode();

// ❌ VIETATO - Props obsoleti
<FormattedText fontSize={32} fixedLines={2} intelligentAccessibilityScaling>
<ResponsiveBox preset="card" autoBackgroundColor="primary">
<ResponsiveImage preset="hero" source={image}>

// ❌ VIETATO - Calcoli manuali
const { width: screenWidth } = Dimensions.get('window');
const isTablet = screenWidth >= 768;
const fontSize = width > 768 ? 32 : 24;
```

### ❌ **GESTIONI MANUALI VIETATE**
```typescript
// ❌ VIETATO - Dark mode manuale
const [isDark, setIsDark] = useState(false);
const backgroundColor = isDark ? '#000000' : '#FFFFFF';
const textColor = isDark ? '#FFFFFF' : '#000000';

// ❌ VIETATO - Scaling manuale
const scaleFont = (size) => size * (screenWidth / 414);
const scaleSpacing = (value) => value * scaleFactor;

// ❌ VIETATO - Breakpoint manuali
if (screenWidth >= 768) { /* Tablet logic */ }
if (width > 1024) { /* Desktop logic */ }

// ❌ VIETATO - Immunità manuale
<Text allowFontScaling={false} numberOfLines={2}>
<FormattedText allowSystemFontScaling={false}>

// ❌ VIETATO - Platform differences
{Platform.OS === 'ios' ? <ComponentA /> : <ComponentB />}
```

### ❌ **CALCOLI DUPLICATI VIETATI**
```typescript
// ❌ VIETATO - Percentuali hardcoded sparse
width: '48%'              // ImpactQuickStats
width: '60%'              // SeguiciScreen  
width: '31%'              // Card components
maxWidth: screenWidth * 0.9  // Modal components

// ❌ VIETATO - Doppio scaling
<PerfectText size={scaleFont(32)}>  // scaleFont già in PerfectText
fontSize: UniversalMillimetricSystem.scaleFont(scaleFont(24))

// ❌ VIETATO - Conditional rendering dispositivi
{isTablet ? 
  <PerfectText size={32}>Grande</PerfectText> : 
  <PerfectText size={20}>Piccolo</PerfectText>
}
```


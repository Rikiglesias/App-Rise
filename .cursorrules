## 💡 **TEMPLATE COMPONENTI AGGIORNATI**

### **COMPONENTE RESPONSIVE STANDARD**
```typescript
import { ResponsiveBox, ResponsiveStack, FormattedText } from '@/components/ui';
import { useResponsiveLayout } from '@/shared/hooks';

const NewComponent = ({ title, description, items }) => {
  const { responsive } = useResponsiveLayout();
  
  return (
    <ResponsiveBox preset="container" autoBackgroundColor="primary">
      <ResponsiveStack spacing={responsive({ compact: 16, standard: 20, xlarge: 24 })}>
    <FormattedText 
      fontSize={40}
      fontWeight="bold"
      lineBreakStrategyIOS="push-out"
      breakStrategyAndroid="highQuality"
      hyphenationFrequencyAndroid="full"
    >
      {title}
    </FormattedText>
    <FormattedText fontSize={16}>{description}</FormattedText>
        
        <ResponsiveStack direction="horizontal" spacing={12} style={{ flexWrap: 'wrap' }}>
          {items.map(item => (
            <ResponsiveCard key={item.id} preset="card" elevated autoBackgroundColor="card">
              <FormattedText fontSize={16}>{item.name}</FormattedText>
            </ResponsiveCard>
          ))}
        </ResponsiveStack>
      </ResponsiveStack>
    </ResponsiveBox>
  );
};
```

### **COMPONENTE CON DARK MODE AVANZATO**
```typescript
import { useResponsiveDarkMode } from '@/shared/hooks';

const DarkModeComponent = ({ title, items }) => {
  const { toggleDarkMode, isDark, textColor } = useResponsiveDarkMode();
  
  return (
    <ResponsiveBox autoBackgroundColor="primary" padding={20}>
      <FormattedText fontSize={24} style={{ color: textColor.primary }}>
        {title}
      </FormattedText>
      
      <ResponsiveStack spacing={12}>
        {items.map(item => (
          <ResponsiveBox 
            key={item.id}
            autoBackgroundColor="card"  // Auto light/dark
            padding={16}
            style={{ borderRadius: 12 }}
          >
            <FormattedText style={{ color: textColor.secondary }}>
              {item.description}
            </FormattedText>
          </ResponsiveBox>
        ))}
      </ResponsiveStack>
      
      <TouchableOpacity onPress={toggleDarkMode}>
        <FormattedText>🌗 Toggle Dark Mode</FormattedText>
      </TouchableOpacity>
    </ResponsiveBox>
  );
};
```

### **LAYOUT CONTROLLATO (FIXED LINES)**
```typescript
const ControlledLayout = ({ text }) => (
  <ResponsiveBox preset="card" autoBackgroundColor="card">
  <FormattedText 
    fontSize={24} 
    fixed={true} 
    fixedLines={2}
    lineBreakStrategyIOS="push-out"
    breakStrategyAndroid="highQuality"
    hyphenationFrequencyAndroid="full"
  >
    {text}
  </FormattedText>
  </ResponsiveBox>
);
```

### **LAYOUT BI-DIREZIONALE INTELLIGENTE (NUOVO)**
```typescript
const IntelligentLayout = ({ title, description }) => (
  <ResponsiveBox preset="container" autoBackgroundColor="primary">
    {/* Titolo con adattamento automatico per ogni dispositivo */}
    <FormattedText 
      fontSize={45}
      fontWeight="bold"
      intelligentAccessibilityScaling={true}  // ← SISTEMA BI-DIREZIONALE
      fixed={true}
      fixedLines={1}                          // ← SEMPRE 1 riga
      lineBreakStrategyIOS="push-out"
      breakStrategyAndroid="highQuality"
    >
      {title}
    </FormattedText>
    
    {/* Descrizione ottimizzata per layout multi-riga */}
    <FormattedText 
      fontSize={16}
      intelligentAccessibilityScaling={true}  // ← ACCESSIBILITÀ + LAYOUT
      fixed={true}
      fixedLines={3}                          // ← SEMPRE 3 righe
    >
      {description}
    </FormattedText>
  </ResponsiveBox>
);

// RISULTATI AUTOMATICI:
// iPhone SE: fontSize ridotto per rispettare fixedLines
// iPad Pro: fontSize ingrandito per utilizzare spazio disponibile  
// Zoom utente: Consentito fino al limite che mantiene fixedLines
// Cross-platform: Comportamento identico iOS/Android
```

### **COMPONENTI CRITICI (TITOLI PRINCIPALI)**
```typescript
const CriticalTitle = ({ title }) => (
  <ResponsiveBox preset="container" autoBackgroundColor="primary">
  <SafeFormattedText 
    fontSize={75} 
    fixed={true} 
    fixedLines={2}
    enableFallbackFontChain={true}
    lineBreakStrategyIOS="push-out"
    breakStrategyAndroid="highQuality"
    hyphenationFrequencyAndroid="full"
  >
    {title}
  </SafeFormattedText>
  </ResponsiveBox>
);
```


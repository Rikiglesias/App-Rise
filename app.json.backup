{
  "expo": {
    "name": "Rise Against Hunger Italia",
    "slug": "rise-against-hunger-italia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#FF6B35",
    "description": "App ufficiale di Rise Against Hunger Italia - Unisciti alla lotta contro la fame nel mondo",
    "privacy": "public",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.riseagainsthunger.italia",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Questa app utilizza la fotocamera per scansionare QR code per donazioni e eventi.",
        "NSLocationWhenInUseUsageDescription": "Questa app utilizza la posizione per trovare eventi locali di Rise Against Hunger."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "edgeToEdgeEnabled": true,
      "package": "org.riseagainsthunger.italia",
      "versionCode": 1,
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION"],
      "statusBarStyle": "dark",
      "statusBarTranslucent": true,
      "statusBarBackgroundColor": "#00000000",
      "softwareKeyboardLayoutMode": "resize",
      "userInterfaceStyle": "light"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "52a33b0f-dec1-4674-812b-de5b888c911a"
      }
    }
  }
}

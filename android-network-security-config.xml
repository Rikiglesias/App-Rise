<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Configurazione per domini aziendali Rise Against Hunger Italia -->
  <domain-config>
    <domain includeSubdomains="true">riseagainsthunger.org</domain>
    <domain includeSubdomains="true">api.riseagainsthunger.org</domain>
    <domain includeSubdomains="true">cdn.riseagainsthunger.org</domain>
    
    <!-- Certificate Pinning per domini principali -->
    <pin-set expiration="2025-12-31">
      <!-- Let's Encrypt R3 intermediate certificate -->
      <pin digest="SHA-256">jQJTbIh0grw0/1TkHSumWb+Fs0Ggogr621gT3PvPKG0=</pin>
      <!-- Let's Encrypt ISRG Root X1 -->
      <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
      <!-- Backup certificate pin -->
      <pin digest="SHA-256">YLh1dUR9y6Kja30RrAn7JKnbQG/uEtLMkBgFF2fuihg=</pin>
    </pin-set>
    
    <!-- Forza l'uso di HTTPS e certificati validi -->
    <trust-anchors>
      <certificates src="system"/>
    </trust-anchors>
  </domain-config>

  <!-- Configurazione per servizi CDN e analytics sicuri -->
  <domain-config>
    <domain includeSubdomains="true">googleapis.com</domain>
    <domain includeSubdomains="true">gstatic.com</domain>
    <domain includeSubdomains="true">crashlytics.com</domain>
    <domain includeSubdomains="true">firebase.googleapis.com</domain>
    
    <!-- Trust system certificates per servizi Google -->
    <trust-anchors>
      <certificates src="system"/>
    </trust-anchors>
  </domain-config>

  <!-- Configurazione globale sicura -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <!-- Solo certificati di sistema fidati -->
      <certificates src="system"/>
    </trust-anchors>
  </base-config>
  
  <!-- Configurazione sviluppo (solo in debug builds) -->
  <debug-overrides>
    <trust-anchors>
      <!-- In debug, permetti anche certificati utente per testing -->
      <certificates src="system"/>
      <certificates src="user"/>
    </trust-anchors>
  </debug-overrides>
</network-security-config> 
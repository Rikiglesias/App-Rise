{
  "name": "riseagainsthungeritalia",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:strict": "npm run conta-problemi",
    "quality-check:summary": "npm run conta-problemi",
    "analisi-completa": "npm run conta-problemi",
    "fix-manuale": "echo '🚫 CORREZIONI AUTOMATICHE DISABILITATE' && echo '💡 Usa editor per correzioni manuali controllate'",
    "helper-manuali": "node scripts/correzioni-manuali-helper.js",
    "conta-problemi": "node scripts/conta-problemi.js",
    "pre-modifiche": "node scripts/workflow-pre-modifiche.js",
    "post-modifiche": "node scripts/workflow-post-modifiche.js",
    "workflow-completo": "npm run pre-modifiche && echo '\\n✅ PRONTO PER SVILUPPO! Procedi con le modifiche, poi esegui: npm run post-modifiche",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:all": "eas build --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:all": "eas submit --platform all",
    "preview": "eas build --profile preview",
    "update": "eas update",
    "update:dev": "eas update --branch development --message",
    "update:preview": "eas update --branch preview --message",
    "update:production": "eas update --branch production --message",
    "update:hotfix": "eas update --branch production --message",
    "update:auto": "eas update --auto",
    "update:gui": "pwsh ./scripts/update-ota.ps1",
    "update:status": "pwsh ./scripts/check-updates.ps1",
    "doctor": "expo doctor",
    "install:clean": "rm -rf node_modules package-lock.json && npm install",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write src/",
    "quality:full": "npm run typecheck && npm run lint && npm run test && npm run format",
    "optimize:android": "node scripts/migrate-to-platform-components.js",
    "migrate:platform": "node scripts/migrate-to-platform-components.js",
    "fix:migration": "node scripts/fix-migration-errors.js",
    "test:android": "npm run android && echo '🤖 Testing Android optimizations...'",
    "test:platform-diff": "echo '📱 iOS behavior preserved, Android optimized!'",
    "setup:git-windows": "git config core.autocrlf true && git config core.safecrlf false && git config core.filemode false",
    "fix:line-endings": "git add --renormalize . && git status",
    "prettier:fix-all": "prettier --write . && git add .",
    "docs:check": "markdownlint docs/ --fix",
    "docs:optional": "echo '📝 Docs check opzionale (non bloccante)' && npm run docs:check || echo '⚠️ Errori docs trovati ma non bloccanti'",
    "bundle:analyze": "node scripts/bundle-analysis.js",
    "bundle:report": "node scripts/bundle-analysis.js && echo '📊 Bundle analysis completed! Check bundle-analysis-report.json for details.'",
    "optimize:bundle": "npm run bundle:analyze && echo '💡 Review recommendations in the report for optimization opportunities.'",
    "pseudo-l10n": "node scripts/pseudo-l10n.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@expo/vector-icons": "^14.1.0",
    "@react-navigation/bottom-tabs": "^7.3.14",
    "@react-navigation/native": "^7.1.10",
    "@react-navigation/native-stack": "^7.3.14",
    "@react-navigation/stack": "^7.3.3",
    "expo": "53.0.16",
    "expo-blur": "^14.1.5",
    "expo-haptics": "~14.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-notifications": "~0.31.3",
    "expo-secure-store": "~14.2.3",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "^0.28.15",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-auto-size-text": "^1.1.1",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-maps": "1.20.1",
    "react-native-pager-view": "6.7.1",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/eslint-config": "^3.2.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.13.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^53.0.7",
    "lint-staged": "^16.1.0",
    "markdownlint-cli": "^0.37.0",
    "prettier": "^3.1.0",
    "react-test-renderer": "^19.0.0",
    "typescript": "~5.8.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings 0 --no-error-on-unmatched-pattern",
      "prettier --write"
    ],
    "scripts/**/*.{js,jsx}": [
      "eslint --max-warnings 0 --no-error-on-unmatched-pattern",
      "prettier --write"
    ]
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "private": true
}
